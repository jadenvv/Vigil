{
  "name": "ReviewerDecision",
  "type": "object",
  "properties": {
    "clerk_user_id": { "type": "string", "description": "Verified Clerk user id (JWT sub) of the reviewer" },
    "flag_id": { "type": "string", "description": "Flag this review decision is about" },
    "action": { "type": "string", "enum": ["approve", "edit", "reject"], "description": "Reviewer action" },
    "final_text": { "type": "string", "description": "Text the reviewer approved or wrote; empty for reject" },
    "original_quote": { "type": "string", "description": "Flag.span at decision time, copied server-side" },
    "page_url": { "type": "string", "format": "uri", "description": "Page the flag was found on, copied server-side" },
    "decided_at": { "type": "string", "format": "date-time", "description": "UTC decision time, generated by the server" },
    "request_id": { "type": "string", "description": "Client-generated idempotency key; retries return the stored row" }
  },
  "required": ["clerk_user_id", "flag_id", "action", "decided_at", "request_id"],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}
