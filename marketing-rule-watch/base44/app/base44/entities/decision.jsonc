{
  "name": "Decision",
  "type": "object",
  "properties": {
    "flag_id": { "type": "string", "description": "Flag this decision is about" },
    "action": { "type": "string", "enum": ["approve", "edit", "reject"], "description": "Reviewer action" },
    "final_text": { "type": "string", "description": "Approved or edited text" },
    "decided_at": { "type": "string", "format": "date-time", "description": "UTC decision time" },
    "session_id": { "type": "string", "description": "App-internal: browser session that made the decision" }
  },
  "required": ["flag_id", "action", "session_id"],
  "rls": {
    "create": true,
    "read": true,
    "update": false,
    "delete": false
  }
}
