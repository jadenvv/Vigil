# Copy to .env (gitignored). Real values live in the team note only.
BRIGHTDATA_TOKEN=
BRIGHTDATA_ZONE=
BRIGHTDATA_SERP_ZONE=
LLM_PROVIDER=groq
GROQ_API_KEY=
# LLM_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=
DAYTONA_API_KEY=
# Admin Base44 token for eval runs against the admin-only detect-text endpoint
EVAL_DETECTOR_TOKEN=

# ── Clerk reviewer workspace ("My reviews") ──────────────────────────────
# Frontend publishable key — public by design. Clerk dashboard → your dev
# instance → API keys → Publishable key. Goes in base44/app/.env.local.
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Backend secrets (npx base44 secrets set, or the dashboard) for the
# reviewer-decision-create / reviewer-decision-list functions.
# Token issuer from the same API-keys page, e.g. https://name.clerk.accounts.dev.
# CLERK_JWT_ISSUER=
# Optional: PEM public key (Clerk dashboard → JWT public key) for networkless
# verification. Without it the functions fetch the issuer JWKS once, then cache.
# CLERK_JWT_KEY=
# Optional: comma-separated allowed `azp` origins (recommended):
# CLERK_AUTHORIZED_PARTIES=https://<your-app-host>,http://localhost:5173
# Never put a CLERK_SECRET_KEY (sk_...) anywhere near the frontend or this file.
